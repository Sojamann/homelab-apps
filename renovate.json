{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "internalChecksAsSuccess": true,
  "flux": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "description": "Grafana plugins in chart values, `- <id>@<version>`, annotated with a `# renovate:` comment on the line above",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*-\\s*[\\w-]+@(?<currentValue>[^\\s@]+)"
      ]
    },
    {
      "description": "CNPG `Cluster.spec.imageName` -- not an `image:` field, so the kubernetes manager misses it",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "customDatasources": {
    "grafana-plugins": {
      "description": "grafana.com plugin catalog -- what Grafana installs from; GitHub releases land there days later",
      "defaultRegistryUrlTemplate": "https://grafana.com/api/plugins/{{packageName}}/versions",
      "transformTemplates": [
        "{\"releases\": items.{\"version\": version, \"releaseTimestamp\": createdAt}}"
      ]
    }
  },
  "packageRules": [
    {
      "description": "Nextcloud cannot skip a major: one major per PR, merged in order (lab docs/src/maintenance.md)",
      "matchPackageNames": [
        "docker.io/library/nextcloud"
      ],
      "separateMultipleMajor": true
    }
  ]
}
